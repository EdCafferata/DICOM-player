    "Bedoeld om te leren en te bekijken, niet om een diagnose te stellen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Lernen und Ansehen gedacht, nicht für eine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meant for learning and viewing, not for making a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensado para aprender y visualizar, no para diagnosticar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçu pour apprendre et visualiser, pas pour poser un diagnostic."

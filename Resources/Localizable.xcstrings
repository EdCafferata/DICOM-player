            "state": "translated",
            "value": "यह सीखने और देखने के लिए है, निदान के लिए नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensato per imparare e visualizzare, non per fare diagnosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習と閲覧のためのもので、診断用ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습과 열람용이며 진단용이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedoeld om te leren en te bekijken, niet om een diagnose te stellen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito para aprender e visualizar, não para diagnóstico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предназначено для обучения и просмотра, а не для постановки диагноза."
          }
        },

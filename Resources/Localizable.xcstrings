    "Dicom Viewer": {
      "shouldTranslate": false
    },
    "Dicom Viewer is bedoeld om te leren en te bekijken. Het is geen medisch hulpmiddel en niet geschikt om een diagnose te stellen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer ist zum Lernen und Ansehen gedacht. Es ist kein Medizinprodukt und nicht für eine Diagnose geeignet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer is meant for learning and viewing. It is not a medical device and is not suitable for making a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer está pensado para aprender y visualizar. No es un producto sanitario y no sirve para diagnosticar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer est conçu pour apprendre et visualiser. Ce n’est pas un dispositif médical et il ne convient pas pour poser un diagnostic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer सीखने और देखने के लिए है। यह चिकित्सा उपकरण नहीं है और निदान के लिए उपयुक्त नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer è pensato per imparare e visualizzare. Non è un dispositivo medico e non è adatto a fare diagnosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer は学習と閲覧のためのアプリです。医療機器ではなく、診断には使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer는 학습과 열람을 위한 앱입니다. 의료기기가 아니며 진단에 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer is bedoeld om te leren en te bekijken. Het is geen medisch hulpmiddel en niet geschikt om een diagnose te stellen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dicom Viewer é feito para aprender e visualizar. Não é um dispositivo médico e não serve para diagnóstico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer предназначен для обучения и просмотра. Это не медицинское изделие, и оно не подходит для постановки диагноза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicom Viewer 用于学习和查看。它不是医疗器械，不适合用于诊断。"
          }
        }
      }
    },

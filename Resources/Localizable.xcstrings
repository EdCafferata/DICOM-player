{
  "sourceLanguage": "en",
  "strings": {
    "%@ wordt permanent verwijderd.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird dauerhaft gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be permanently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se eliminará de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprimé définitivement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ स्थायी रूप से हटा दी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verrà eliminato definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt permanent verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será excluído permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ будет удалён без возможности восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将被永久删除。"
          }
        }
      }
    },
    "%@ — %lld bestanden worden permanent verwijderd.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld Dateien werden dauerhaft gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld files will be permanently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — se eliminarán %2$lld archivos de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld fichiers seront supprimés définitivement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld फ़ाइलें स्थायी रूप से हटा दी जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld file verranno eliminati definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld 個のファイルが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — 파일 %2$lld개가 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %lld bestanden worden permanent verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld arquivos serão excluídos permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — файлов: %2$lld, будут удалены без возможности восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld 个文件将被永久删除。"
          }
        }
      }
    },

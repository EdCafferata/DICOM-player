        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño agradecimiento al desarrollador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit merci au développeur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपर के लिए एक छोटा सा धन्यवाद"
